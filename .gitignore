# Rust build output
/target/

# ---------------------------------------------------------------------------
# PERSONAL DATA NEVER GOES IN THIS REPOSITORY.
#
# The application keeps everything in one folder outside the working tree
# (~/.vn-finance by default), and it refuses to open a data directory that sits
# inside a git work tree. These rules exist as a second line of defence: if
# someone points the vault at the checkout anyway, or copies one in by hand, git
# must not pick it up.
# ---------------------------------------------------------------------------
.vn-finance/
vn-finance-data/
profile.json
**/ledger/*.jsonl
**/obligations/*.jsonl
**/audit/*.jsonl
**/documents/index.json

# The golden fixtures are named after the files the domain reads, and one of them is
# `profile.json`. The rule above is about a vault and this file is not one: without this
# line the rule swallows a 45 KiB test fixture, git never stores it, and a fresh clone
# cannot compile the golden test at all. That is what the first Linux CI run found.
!crates/core/tests/golden/profile.json

# Exported backups
exports/
*.vnfin-backup

# The RULE PACKS are law, not personal data, and are meant to be versioned and
# reviewed: rules/**/*.json stays tracked.
#
# The same goes for the committed fixture vault: it was written by the reference
# application so this one can prove it opens a real one, and every value in it is
# invented. Re-including it here is deliberate.
!crates/store/tests/fixtures/**

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
.env
.env.*

# Screenshots taken by hand while working on the window, not part of the product.
screenshots/
