# Normalise line endings to LF in the repository and in the working tree, so the
# published source is byte-identical on every platform and diffs stay readable.
* text=auto eol=lf

# Never touch binary content.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff2 binary

# The application icon's raw bytes, read straight into egui::IconData. A text filter
# that "normalised" line endings here would corrupt the icon without saying so.
*.rgba binary
